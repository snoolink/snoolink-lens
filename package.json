{
  "name": "snoolink-lens",
  "version": "1.0.0",
  "description": "Desktop semantic image search for image_metadata_results.json",
  "author": "Jay Dev",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:mac:universal": "electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.snoolink.lens.desktop",
    "productName": "Snoolink Lens",
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.cjs",
      "*.html",
      "*.css",
      "assets/**/*",
      "assets/*.ico",
      "assets/*.icns",
      "assets/*.png",
      "data/*.json",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "config/default.env",
        "to": "config/default.env"
      },
      {
        "from": "models/face-api",
        "to": "models/face-api"
      }
    ],
    "win": {
      "icon": "assets/app-icon-256.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/favicon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography"
    },
    "dmg": {
      "icon": "assets/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1022.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tensorflow/tfjs": "^4.20.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "exifr": "^7.1.3",
    "file-type": "^19.6.0",
    "heic-convert": "^2.1.0",
    "image-hash": "^5.3.2",
    "sharp": "^0.33.5",
    "twelvelabs-js": "^0.4.12"
  }
}
